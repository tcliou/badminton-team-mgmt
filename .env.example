# Supabase project credentials (從 Supabase Dashboard 取得)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# username 帳號的合成 email 網域；只在 Supabase Auth 內部使用，不會寄信
# 修改後請同步更新 supabase/migrations 內的 seed
VITE_SYNTHETIC_EMAIL_DOMAIN=team.local

# 應用程式名稱（會顯示在標題列、Layout 上）
VITE_APP_NAME=羽球校隊管理系統

# Vite base path：本機開發保持 '/'；部署到 GitHub Pages 則為 '/<repo-name>/'
# 在 GitHub Actions 中由 secrets 注入
VITE_BASE_PATH=/
